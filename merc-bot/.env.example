# Discord
DISCORD_TOKEN=
DISCORD_GUILD_ID=
FAMILY_X_MERC_MANAGER_ROLE_ID=
VERIFIED_ROLE_ID=
FAMILY_X_ROLE_ID=
MERC_REQUESTS_CHANNEL_ID=

# Base64 32-byte key that encrypts stored Torn API keys. Generate with: openssl rand -base64 32
# Keep a copy somewhere safe: if it's lost, every key has to be added again.
MERC_KEY_MASTER=

# Postgres (on Railway, reference the Postgres service, e.g. ${{Postgres.PGHOST}})
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# Optional
BSP_VERSION=9.4.7
CALLS_PER_KEY_PER_MINUTE=90
